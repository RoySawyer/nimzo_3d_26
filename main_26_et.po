#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Mootori tagasiastumise valikud"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Näita mootori tagasiastumise valikute dialoogiboksi"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Mootoriturniiril ei tohi olla rohkem kui 100 mootorit."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Mootori tagasiastumise valikud"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Võimalus dokkida Free Internet Chess Serveri (FICS) akent (versioon 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automaatne mootori väljalülitumine kadunud asendis (versioon 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (versioon 4.41) mitmekeelne,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Nimzo_3d versioonile 4.41 lisatud funktsioonid"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Mootor hindab oma asukohta kadunuks"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "ja pakub tagasiastumist."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Kas te võtate lahkumisavalduse vastu?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Mootori loobumisteade"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Ära paku selles mängus enam tagasiastumisavaldust"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Luba mootori automaatne tagasiastumine"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Tagasiastumise lävi (Etturid: -1,0 kuni -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimaalne otsingusügavus (kihid: 1–30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Järjestikused pöörded alla läve (1–10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Enne esimest kontrolli tehtud mängukäigud (1–50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Ooteaja käigud tagasilükatud lahkumisavalduse korral (1–50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Kaasa sunnitud matid"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Luba tagasiastumise reeglid tulistamise teel"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Mängija mootori vastu mängud"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Küsi enne tagasiastumist"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Võimaldab mootori automaatset väljalülitumist."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Määrab ära numbrilise etturi puudujäägi, mis on vajalik tagasiastumise pakkumiseks."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Minimaalne otsingusügavus, mille mootor peab saavutama enne lahkumispakkumist."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Järjestikuste käikude arv, mille arv on halvem kui läviväärtus"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "enne lahkumisavalduse esitamist."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Mängus tehtud käikude arv enne loobumispakkumist."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Käikude arv pärast keeldumist enne, kui tagasiastumist saab uuesti pakkuda."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Sundmatti korral tagasiastumise pakkumiseks märkige."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Kontrolli, kas mootor annab väljalaskerežiimis alla, kui see on õigustatud."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Märkige ruut, et küsida kasutajalt nõusolekut, kui mootor pakub väljaastumist."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Mootori automaatne väljalülitumine võimaldab nõrgenenud või täielikult mootorid välja lülitada"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "pakkuda standardset lahkumisavaldust, selle asemel, et sundida teid aega ja vaeva kulutama"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "mängides viimase käiguni täiesti kaotatud positsiooni välja."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Valikute konfiguratsiooni kirjeldus -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Luba malemootor automaatselt tagasi astuma – märkige see ruut, et lubada malemootoril tagasiastumist pakkuda."

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Tagasiastumise lävi - Määrake etturites numbriline hindamislävi."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "et mootor lahkumisavalduse esitaks, peab positsioon olema halvem."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Vaikimisi on etturite arv -15,0. Ainult mootoriga mängudes saab selle määrata ka -3,0-ni."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimaalne otsingusügavus – sisestage sügavus, milleni mootor peab enne otsingut jõudma."

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "mootor pakub väljaastumist. See hoiab ära arvutuste varajased hüpped või volatiilsed muutused."

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktikalised ohverdused paanikahoogude põhjustamisest."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Järjestikused pöörded alla läve - Sisestage käikude arv, mis on halvemad kui"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "lävi, mis tuleb ületada enne, kui mootor pakub väljaastumist."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "See on lisakontroll, mis on hädavajalik tugevalt gaasiga koormatud mootorite puhul."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "mis ei ulatu kunagi sügavamale otsingusügavuseni."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimaalne mängukäikude arv - sisestage käikude arv, mida tuleb teha"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "mängus enne lahkumisavalduse esitamist."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Keeldumise korral ootamiseks vajalikud käigud – sisesta täiskäikude arv, mille mootor"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "peab ootama pärast seda, kui kasutaja keeldub lahkumispakkumisest, enne kui mootor"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "pakub uuesti tagasiastumist."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Lisa sunnitud matid – Märgi, et lisada mootori poolt ette nähtud sunnitud matid."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "lahkumispakkumise kriteeriumides."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Võid selle välja jätta, kui tahad endale mati välja mõelda."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Mootori tagasiastumine laskmise režiimis - kontrollige, kas mootor annab tagasiastumise režiimis."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "kui muud lahkumiskriteeriumid on täidetud."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Küsi enne tagasiastumist – Märgi, kui soovid, et mootor küsiks kasutajalt nõusolekut"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "enne kui see inimese ja mootori vahelises mängus tagasi astub."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "Mootori ja mootori mängudes annab mootor vaikselt alla,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "ilma luba küsimata."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Mootori tagasiastumise dokumentatsioon"

#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Moottorin uusimisvaihtoehdot"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Näytä moottorin uudelleenasentamisasetusten valintaikkuna"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Moottorikilpailussa ei saa olla yli 100 moottoria."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Moottorin irtisanomisvaihtoehdot"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Mahdollisuus telakoida Free Internet Chess Server (FICS) -ikkuna (versio 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automaattinen moottorin irtisanoutuminen kadonneessa asennossa (versio 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (versio 4.41) monikielinen,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Nimzo_3d:hen lisätyt ominaisuudet - versio 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Moottori arvioi sijaintinsa kadonneeksi"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "ja tarjoaa irtisanoutumista."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Hyväksytkö irtisanoutumisen?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Moottorin irtisanomisilmoitus"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Älä tarjoa luovutusoikeutta enää tässä pelissä"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Ota moottorin automaattinen palautus käyttöön"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Luopumiskynnys (Sotilasnumerot: -1,0 - -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Pienin hakusyvyys (Kerrokset: 1–30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Peräkkäiset käännökset kynnyksen alapuolella (1–10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Ennen ensimmäistä tarkistusta pelatut pelisiirrot (1–50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Siirtyy odottamaan, jos eroaminen hylätään (1–50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Sisällytä pakotetut matit"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Ota käyttöön rangaistuspotkukilpailun eroamissäännöt"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Pelaaja vastaan ​​moottori -pelit"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Kysy ennen irtisanoutumista"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Mahdollistaa moottorin automaattisen sammumisen."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Määrittää numeerisen sotilasvajeen, joka vaaditaan eroamisen tarjoamiseen."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Hakusyvyys, joka hakukoneen on saavutettava ennen kuin irtisanoutumista tarjotaan."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Kynnysarvoa huonompien peräkkäisten siirtojen määrä"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "ennen kuin irtisanoudutaan."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Pelattujen siirtojen määrä ennen luovutustarjousta."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Siirtojen määrä kieltäytymisen jälkeen ennen kuin eroa voidaan tarjota uudelleen."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Rastita tarjoutuaksesi eroamaan, kun pakotettu matti on olemassa."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Tarkista, että moottori irtoaa iskureaktiotilassa, jos se on perusteltua."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Valitse tämä, jos haluat kysyä käyttäjältä suostumusta, kun hakukone tarjoaa irtisanoutumista."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Moottorin automaattinen irtisanoutuminen mahdollistaa heikentyneiden tai kokonaan sammuvien moottoreiden käytön"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "tarjota vakiomuotoinen irtisanoutumispyyntö sen sijaan, että pakottaisi sinut käyttämään aikaa ja vaivaa"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "pelaamalla täysin kadonneen aseman viimeiseen siirtoon asti."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Asetuskonfiguraation kuvaus -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Ota moottorin automaattinen eroaminen käyttöön - Valitse tämä, jos haluat shakkimoottorin tarjoavan eroamista."

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Luopumiskynnys - Aseta numeerinen arviointikynnys sotilaille."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "että tilanteen on oltava huonompi, jotta moottori tarjoaa eroa."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Oletusarvo on -15,0 sotilasta. Pelkkien pelimoottorien peleissä tämä voidaan asettaa jopa -3,0:aan."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Pienin hakusyvyys - Syötä syvyys, johon moottorin on päästävä ennen"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "moottori tarjoaa irtisanoutumista. Tämä estää laskennan aikaiset piikit tai epävakaat arvot."

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktisia uhrauksia paniikkierosten aiheuttamisesta."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Peräkkäiset käännökset kynnyksen alapuolella - Syötä kynnystä huonompien siirtojen lukumäärä"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "kynnys, joka on ylitettävä ennen kuin moottori tarjoaa irtisanoutumista."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Tämä on lisätarkistus, joka on välttämätön voimakkaasti kaasutetuille moottoreille."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "jotka eivät koskaan saavuta syvempiä hakutuloksia."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Pelin vähimmäissiirtoraja - Syötä pelattavien siirtojen määrä"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "pelissä ennen eroamistarjousta."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Odottavat siirrot, jos hylkäys kohdataan - Syötä moottorin suorittamien täysien siirtojen lukumäärä"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "on odotettava käyttäjän kieltäytyessä hyväksymästä irtisanomistarjousta, ennen kuin moottori"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "tarjoutuu taas irtisanoutumaan."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Sisällytä pakotetut matit - Rastita, jos haluat sisällyttää pakotetut matit, jotka moottori ennakoi."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "irtisanoutumistarjouksen kriteereissä."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Voit jättää tämän pois, jos haluat selvittää itsellesi matin."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Luovu moottorin laukeaminen alkusysäyksessä - Tarkista, että moottori luopuu alkusysäystilassa."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "jos muut irtisanoutumiskriteerit täyttyvät."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Kysy ennen irtisanoutumista - Valitse, jos haluat hakukoneen pyytävän käyttäjältä suostumuksen"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "ennen kuin se eroaa ihminen vastaan ​​moottori -pelissä."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "Moottori vastaan ​​moottori -peleissä moottori luovuttaa hiljaa,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "kysymättä lupaa."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Moottorin luopumisasiakirjat"

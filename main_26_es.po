#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Opciones de renovación del motor"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Mostrar el cuadro de diálogo de opciones de redefinición del motor"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "En un torneo de motores no puede haber más de 100 motores."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Opciones de redefinición del motor"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Opción para acoplar la ventana del Servidor de Ajedrez Gratuito por Internet (FICS) (versión 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Desconexión automática del motor en caso de pérdida de posición (versión 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (versión 4.41) multilingüe,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Funcionalidades añadidas a Nimzo_3d - versión 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "El motor evalúa su posición como perdida"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "y ofrece su dimisión."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "¿Aceptas la renuncia?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Mensaje de renuncia del motor"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "No te ofrezcas a renunciar de nuevo en este juego."

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Habilitar el auto-reinicio del motor"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Umbral de renuncia (Peones: -1,0 a -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Profundidad mínima de búsqueda (Capas: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Turnos consecutivos por debajo del umbral (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Movimientos de juego realizados antes del primer control (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Mociones para esperar si se rechaza la renuncia (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Incluir jaque mates forzados"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Habilitar las reglas de renuncia por penaltis"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Juegos de jugador contra motor"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Pregunta antes de renunciar"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Permite la desactivación automática del motor."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Define el déficit numérico de peones necesario para ofrecer la renuncia."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Profundidad mínima de búsqueda que el motor debe alcanzar antes de que se ofrezca la opción de renuncia."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Número de movimientos consecutivos peores que el umbral"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "antes de que se presente la renuncia."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Número de movimientos realizados en una partida antes de que se ofrezca la rendición."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Número de movimientos después de una negativa antes de que se pueda volver a ofrecer la renuncia."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Marque la casilla para presentar la renuncia cuando haya un jaque mate forzado."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Compruebe si el motor debe renunciar al modo de prueba, si está justificado."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Marque la opción para solicitar el consentimiento del usuario cuando el motor ofrezca la opción de renunciar."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "La función de auto-renuncia del motor permite el funcionamiento de motores debilitados o que fallan por completo."

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "ofrecer una renuncia estándar, en lugar de obligarte a invertir tiempo y esfuerzo."

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "jugar una posición completamente perdida hasta el último movimiento."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Descripción de la configuración de opciones -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Habilitar la renuncia automática del motor: marque esta casilla para habilitar la opción de renunciar."

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Umbral de renuncia: establece el umbral de evaluación numérica en peones."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "que la situación tiene que ser peor que eso, para que el motor ofrezca su dimisión."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "El valor predeterminado es -15,0 peones. Este valor podría reducirse hasta -3,0 para partidas solo con motor de juego."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Profundidad mínima de búsqueda: introduzca la profundidad que el motor debe alcanzar antes"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "El motor ofrece renunciar. Esto evita picos de cálculo tempranos o volatilidad."

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "Sacrificios tácticos para evitar dimisiones por pánico."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Turnos consecutivos por debajo del umbral: ingrese el número de movimientos peores que"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "el umbral que debe superarse antes de que el motor ofrezca renunciar."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Esta es una comprobación adicional, esencial para motores con aceleración muy elevada."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "que nunca alcanzan mayores profundidades de búsqueda."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Límite mínimo de movimientos del juego: introduzca el número de movimientos que deben realizarse."

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "en un juego antes de que se ofrezca la renuncia."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Movimientos a esperar si se encuentra un rechazo: introduzca el número de movimientos completos que el motor"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "tiene que esperar después de que el usuario rechace una oferta de renuncia, antes de que el motor"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "Ofrece dimitir de nuevo."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Incluir jaque mates forzados: compruebe que se incluyan los jaque mates forzados previstos por el motor."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "en los criterios de la oferta de renuncia."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Si lo que quieres es calcular tú mismo un jaque mate, quizás quieras omitir esta opción."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Renunciar en el modo de prueba de motores: compruebe si el motor renuncia en el modo de prueba de motores."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "si se han cumplido los demás criterios de renuncia."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Pregunta antes de renunciar: comprueba si quieres que el motor obtenga el consentimiento del usuario."

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "antes de que se rinda en una partida entre un humano y la máquina."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "En los juegos de motor contra motor, el motor se rendirá silenciosamente,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "sin pedir permiso."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Documentación de renuncia del motor"

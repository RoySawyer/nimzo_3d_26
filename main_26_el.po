#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Επιλογές τερματισμού λειτουργίας κινητήρα"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Εμφάνιση του παραθύρου διαλόγου επιλογών τερματισμού λειτουργίας του μηχανισμού"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Δεν μπορούν να υπάρχουν περισσότερες από 100 μηχανές σε ένα τουρνουά μηχανών."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Επιλογές παραίτησης κινητήρα"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Μια επιλογή για σύνδεση του παραθύρου Free Internet Chess Server (FICS) (έκδοση 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Αυτόματη απενεργοποίηση κινητήρα σε χαμένη θέση (έκδοση 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (έκδοση 4.41) πολύγλωσσο,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Χαρακτηριστικά που προστέθηκαν στο Nimzo_3d - έκδοση 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Ο κινητήρας αξιολογεί τη θέση του ως χαμένη"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "και προσφέρει την παραίτησή του."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Δέχεστε την παραίτηση;"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Μήνυμα παραίτησης κινητήρα"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Μην προσφερθείς ξανά να παραιτηθείς σε αυτό το παιχνίδι"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Ενεργοποίηση αυτόματης εγκατάλειψης κινητήρα"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Όριο παραίτησης (Ενέχυρα: -1,0 έως -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Ελάχιστο βάθος αναζήτησης (Πτυχές: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Διαδοχικές στροφές κάτω από το όριο (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Κινήσεις παιχνιδιού που παίχτηκαν πριν από τον πρώτο έλεγχο (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Κινήσεις αναμονής σε περίπτωση απόρριψης της παραίτησης (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Συμπεριλάβετε αναγκαστικά ματ"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Ενεργοποίηση κανόνων παραίτησης από ανταλλαγή πυροβολισμών"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Παιχνίδια παίκτη εναντίον μηχανής"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Ρωτήστε πριν παραιτηθείτε"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Επιτρέπει την αυτόματη απενεργοποίηση του κινητήρα."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Ορίζει το αριθμητικό έλλειμμα πιόνι που απαιτείται για να προσφερθεί η παραίτηση."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Ελάχιστο βάθος αναζήτησης που πρέπει να επιτύχει η μηχανή πριν από την προσφορά παραίτησης."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Αριθμός διαδοχικών κινήσεων χειρότερων από το όριο"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "πριν από την υποβολή της παραίτησης."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Αριθμός κινήσεων που παίχτηκαν σε ένα παιχνίδι πριν προσφερθεί η παραίτηση."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Αριθμός κινήσεων μετά από μια άρνηση πριν από την παραίτηση που μπορεί να προσφερθεί ξανά."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Σημειώστε για να προσφέρετε παραίτηση όταν υπάρχει αναγκαστικό ματ."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Ελέγξτε εάν ο κινητήρας απενεργοποιείται σε λειτουργία πυροβολισμού, εάν δικαιολογείται."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Επιλέξτε για να ζητείται η συγκατάθεση του χρήστη όταν η μηχανή προσφέρει να παραιτηθεί."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Η αυτόματη παραίτηση κινητήρα επιτρέπει την εξασθενημένη ή εντελώς απώλεια κινητήρων"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "να προσφέρει τυπική παραίτηση, αντί να σας αναγκάσει να ξοδέψετε χρόνο και προσπάθεια"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "παίζοντας μια εντελώς χαμένη θέση μέχρι την τελευταία κίνηση."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Περιγραφή διαμόρφωσης επιλογών -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Ενεργοποίηση αυτόματης παραίτησης μηχανής - Επιλέξτε για να ενεργοποιήσετε τη μηχανή σκακιού ώστε να προσφέρει παραίτηση"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Όριο παραίτησης - Ορίστε το αριθμητικό όριο αξιολόγησης σε πιόνια."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "ότι η θέση πρέπει να είναι χειρότερη από, για να προσφέρει η μηχανή παραίτηση."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Η προεπιλογή είναι -15,0 πιόνια. Αυτή η τιμή μπορεί να οριστεί έως και -3,0 για παιχνίδια μόνο με μηχανή."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Ελάχιστο βάθος αναζήτησης - Εισαγάγετε το βάθος στο οποίο πρέπει να φτάσει η μηχανή πριν"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "η μηχανή προσφέρεται να παραιτηθεί. Αυτό αποτρέπει τις πρώιμες αιχμές υπολογισμών ή την αστάθεια"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "τακτικές θυσίες από την πρόκληση πανικού και παραιτήσεων."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Διαδοχικές στροφές κάτω από το όριο - Εισαγάγετε τον αριθμό των κινήσεων χειρότερων από"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "το όριο που πρέπει να περάσει πριν ο κινητήρας προσφέρει την παραίτησή του."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Αυτός είναι ένας πρόσθετος έλεγχος, απαραίτητος για κινητήρες με πολύ μεγάλο στραγγαλισμό."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "που δεν φτάνουν ποτέ σε βαθύτερα βάθη αναζήτησης."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Ελάχιστο όριο κινήσεων παιχνιδιού - Εισαγάγετε τον αριθμό των κινήσεων που πρέπει να παιχτούν"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "σε ένα παιχνίδι πριν προταθεί η παραίτηση."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Κινήσεις προς αναμονή σε περίπτωση άρνησης - Εισαγάγετε τον αριθμό των πλήρων κινήσεων που θα εκτελέσει η μηχανή"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "πρέπει να περιμένει αφού ο χρήστης αρνηθεί να αποδεχτεί μια προσφορά παραίτησης, πριν η μηχανή"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "προτείνει ξανά την παραίτησή του."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Συμπερίληψη αναγκαστικών ματ - Ελέγξτε για να συμπεριλάβετε αναγκαστικά ματ, που προβλέπονται από τη μηχανή,"

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "στα κριτήρια της προσφοράς παραίτησης."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Ίσως θελήσετε να το παραλείψετε αυτό, αν θέλετε να πετύχετε ματ για τον εαυτό σας."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Παραίτηση σε λειτουργία ανταλλαγής πυροβολισμών κινητήρα - Ελέγξτε αν ο κινητήρας θα παραιτηθεί σε λειτουργία ανταλλαγής πυροβολισμών,"

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "εφόσον έχουν πληρωθεί τα υπόλοιπα κριτήρια παραίτησης."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Ρωτήστε πριν παραιτηθείτε - Ελέγξτε αν θέλετε η μηχανή να λάβει συγκατάθεση από τον χρήστη"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "πριν παραιτηθεί σε ένα παιχνίδι ανθρώπου εναντίον μηχανής."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "Στα παιχνίδια Engine εναντίον Engine, η μηχανή θα παραιτηθεί σιωπηλά,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "χωρίς να ζητήσει άδεια."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Τεκμηρίωση για την παραίτηση από τον κινητήρα"

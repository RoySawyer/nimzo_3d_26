#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Možnosti odhlášení motoru"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Zobrazit dialogové okno s možnostmi odhlášení motoru"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "V turnaji motorů nemůže být více než 100 motorů."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Možnosti odstoupení motoru"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Možnost ukotvení okna Free Internet Chess Server (FICS) (verze 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automatické odstoupení motoru při ztrátě pozice (verze 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (verze 4.41) vícejazyčný,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Nové funkce do Nimzo_3d - verze 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Motor vyhodnotí svou polohu jako ztracenou"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "a nabízí rezignaci."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Přijímáte rezignaci?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Zpráva o odstoupení motoru"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "V této hře už nenabízej rezignaci"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Povolit automatické odhlášení enginu"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Práh rezignace (pěšáci: -1,0 až -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimální hloubka vyhledávání (vrstvy: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Po sobě jdoucí otočky pod prahovou hodnotou (1–10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Herní tahy odehrané před prvním šachem (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Pokračování v případě odmítnutí rezignace (1–50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Zahrnout vynucené maty"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Povolit pravidla pro odstoupení po nájezdech"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Hry typu Player versus engine"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Zeptejte se před rezignací"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Umožňuje automatické odhlášení motoru."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Definuje číselný deficit pěšce potřebný k nabídnutí rezignace."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Minimální hloubka vyhledávání, které musí vyhledávač dosáhnout, než je nabídnuta rezignace."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Počet po sobě jdoucích tahů horších než prahová hodnota"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "než bude podána rezignace."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Počet tahů odehraných v partii před podáním rezignace."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Počet tahů po odmítnutí před opětovnou nabídkou rezignace."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Šach nabídnout rezignaci, když je vynucený mat."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "V případě oprávněných důvodů zkontrolujte, zda motor v režimu přestřelky odejde."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Zaškrtněte, chcete-li vyzvat uživatele k souhlasu, když vyhledávač nabídne rezignaci."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Automatické odhlášení motoru umožňuje oslabení nebo úplnou ztrátu motorů"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "nabídnout standardní rezignaci, spíše než vás nutit vynakládat čas a úsilí"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "odehrávání zcela ztracené pozice až do posledního tahu."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Popis konfigurace možností -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Povolit automatické odstoupení enginu – Zaškrtněte, pokud chcete, aby šachový engine nabízel odstoupení"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Práh rezignace - Nastavte číselný práh vyhodnocení v pěšácích."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "že pozice musí být horší, aby motor nabídl rezignaci."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Výchozí hodnota je -15,0 pěšců. Pro hry pouze s enginem lze nastavit až -3,0."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimální hloubka vyhledávání - Zadejte hloubku, které musí vyhledávač dosáhnout, než"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "motor nabízí rezignaci. Tím se zabrání předčasným výpočetním špičkám nebo volatilitě"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktické oběti z vyvolání panických rezignací."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Po sobě jdoucí tahy pod prahovou hodnotou - Zadejte počet horších tahů než"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "prahová hodnota, kterou je nutné překonat, než motor nabídne rezignaci."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Toto je dodatečná kontrola, nezbytná u motorů s vysokým stupněm škrcení."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "které nikdy nedosáhnou hlubších hloubky vyhledávání."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimální počet tahů ve hře - Zadejte počet tahů, které je třeba odehrát"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "ve hře před podáním rezignace."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Počet tahů, které se mají čekat v případě odmítnutí - Zadejte počet celých tahů, které engine provede."

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "musí čekat poté, co uživatel odmítne přijmout nabídku rezignace, než motor"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "znovu nabízí rezignaci."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Zahrnout vynucené vazby - Zaškrtněte pro zahrnutí vynucených vazeb, které engine předvídá."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "v kritériích pro nabídku rezignace."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Možná byste tohle měli vynechat, pokud si chcete vybojovat mat."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Odmítnutí poruchy motoru - Zkontrolujte, zda motor v režimu přestřelky odejde."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "pokud byly splněny ostatní podmínky pro rezignaci."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Zeptat se před rezignací – Zaškrtněte, pokud chcete, aby vyhledávač získal souhlas uživatele."

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "než rezignuje ve hře člověk versus motor."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "Ve hrách engine versus engine se engine tiše vzdá,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "bez žádání o svolení."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Dokumentace k odstoupení od smlouvy s motorem"

#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Motor leszerelési lehetőségek"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "A motor lemondási beállításai párbeszédpanel megjelenítése"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Egy motorversenyen nem lehet 100-nál több motor."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Motorleszerelési lehetőségek"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Lehetőség a Free Internet Chess Server (FICS) ablak dokkolására (4.4-es verzió)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automatikus motorleállás elveszett pozícióban (4.41-es verzió)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (4.41-es verzió) többnyelvű,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "A Nimzo_3d 4.41-es verziójához hozzáadott funkciók"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "A motor elveszettként értékeli a helyzetét"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "és felajánlja a lemondását."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Elfogadja a lemondását?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Motor lemondási üzenet"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Ne ajánld fel újra a feladásodat ebben a meccsben"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Motor automatikus lemondásának engedélyezése"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Feladási küszöb (Gyalogok: -1,0 és -50,0 között)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimális keresési mélység (Rétegek: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Egymást követő fordulók a küszöbérték alatt (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Az első ellenőrzés előtt lejátszott játéklépések (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Várakozási lépések lemondás elutasítása esetén (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Kényszerített mattok is"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Lemondási szabályok engedélyezése a tűzpárbajra"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Játékos a motor ellen játékok"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Kérdezzen felmondás előtt"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Lehetővé teszi a motor automatikus leállítását."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Meghatározza a felmondáshoz szükséges numerikus gyaloghiányt."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "A minimális keresési mélység, amelyet a motornak el kell érnie a kilépés felajánlása előtt."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "A küszöbértéknél rosszabb egymást követő lépések száma"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "mielőtt felajánlják a lemondásukat."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "A játékban lejátszott lépések száma, mielőtt a felmondást felajánlják."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "A lemondás visszautasítása utáni lépések száma, mielőtt újra felajánlható lenne a lemondás."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Kényszerített matt esetén a felmondás felajánlása pipával történik."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Ellenőrizd, hogy a motor leáll-e tűzpárbaj üzemmódban, ha indokolt."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Jelölje be, ha a felhasználó beleegyezését szeretné kérni, amikor a motor felajánlja a kilépést."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "A motor automatikus lemondása lehetővé teszi a legyengült vagy teljesen lemerült motorokat"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "hogy szabványos felmondást ajánljon fel, ahelyett, hogy időt és energiát kényszerítene rá"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "egy teljesen elveszett pozíciót játssz ki az utolsó lépésig."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Opciók konfigurációjának leírása -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Automatikus kilépés engedélyezése - Jelölje be, ha azt szeretné, hogy a sakkmotor felajánlja a kilépést"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Felmondási küszöb - Állítsa be a gyalogok numerikus értékelési küszöbét."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "hogy a pozíciónak rosszabbnak kell lennie, mint ahhoz, hogy a motor felajánlja lemondását."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Az alapértelmezett érték -15,0 gyalog. Csak motoros játékoknál ez akár -3,0-ra is beállítható."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimális keresési mélység - Adja meg azt a mélységet, amelyet a motornak el kell érnie, mielőtt"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "a motor felajánlja a kilépést. Ez megakadályozza a korai számítási csúcsokat vagy az ingadozó"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktikai áldozatokat a pánikszerű lemondások kiváltásától."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Egymást követő fordulók a küszöbérték alatt - Adja meg a küszöbértéknél rosszabb lépések számát"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "az a küszöbérték, amelyet át kell lépni, mielőtt a motor felajánlja a kilépést."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Ez egy kiegészítő ellenőrzés, amely elengedhetetlen a nagy fojtású motoroknál"

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "amelyek soha nem érnek el mélyebb keresési mélységeket."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimális játéklépés-korlát - Adja meg a megteendő lépések számát"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "egy játékban, mielőtt felajánlják a lemondást."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Várakozási lépések elutasítás esetén - Adja meg a motor által megtett teljes lépések számát."

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "várnia kell, miután a felhasználó nem hajlandó elfogadni a felmondási ajánlatot, mielőtt a motor"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "ismét felajánlja a lemondását."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Kényszerített mattok belefoglalása - Jelölje be, hogy a motor által előre látható kényszerített mattok is benne legyenek."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "a lemondási ajánlat kritériumaiban."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Ezt érdemes lehet kihagyni, ha mattot akarsz kitalálni magadnak."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Lemondás a motorleállításban - Ellenőrizze, hogy a motor lemond-e a leállítási módban."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "ha a többi lemondási kritérium teljesült."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Kérdezzen rá kilépés előtt - Jelölje be, ha azt szeretné, hogy a motor kérje a felhasználó beleegyezését"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "mielőtt feladja egy ember kontra motor játékban."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "A motorok elleni játékokban a motor csendben lemond,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "engedély kérése nélkül."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Motor leszerelési dokumentációja"

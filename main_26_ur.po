#: main_26.cpp:35
msgid "Engine resign options"
msgstr "انجن استعفی دینے کے اختیارات"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "انجن استعفیٰ کے اختیارات کا ڈائیلاگ باکس دکھائیں۔"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "انجن ٹورنامنٹ میں 100 سے زیادہ انجن نہیں ہو سکتے۔"

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "انجن استعفی کے اختیارات"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "مفت انٹرنیٹ شطرنج سرور (FICS) ونڈو (ورژن 4.4) کو ڈاک کرنے کا اختیار"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "کھوئی ہوئی پوزیشن میں انجن کا خودکار استعفیٰ (ورژن 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (ورژن 4.41) کثیر لسانی،"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Nimzo_3d - ورژن 4.41 میں خصوصیات شامل کی گئیں۔"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "انجن کھوئے ہوئے کے طور پر اپنی پوزیشن کا اندازہ کرتا ہے۔"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "اور مستعفی ہونے کی پیشکش کرتا ہے۔"

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "کیا آپ استعفیٰ قبول کرتے ہیں؟"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "انجن استعفیٰ کا پیغام"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "اس کھیل کو دوبارہ استعفی دینے کی پیشکش نہ کریں۔"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "انجن خودکار استعفی کو فعال کریں۔"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "استعفیٰ کی حد (پیادے: -1.0 سے -50.0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "تلاش کی کم از کم گہرائی (Plies: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "حد سے نیچے لگاتار موڑ (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "پہلی جانچ سے پہلے کھیلی گئی چالیں (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "استعفیٰ مسترد ہونے کی صورت میں انتظار کرنے کی کوشش کرتا ہے (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "جبری چیک میٹ شامل کریں۔"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "شوٹ آؤٹ استعفیٰ کے قواعد کو فعال کریں۔"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "پلیئر بمقابلہ انجن گیمز"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "استعفیٰ دینے سے پہلے پوچھ لیں۔"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "خودکار انجن استعفی کو فعال کرتا ہے۔"

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "استعفیٰ پیش کرنے کے لیے درکار عددی پیادہ خسارے کی وضاحت کرتا ہے۔"

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "استعفیٰ پیش کرنے سے پہلے انجن کو تلاش کی کم از کم گہرائی حاصل کرنا ضروری ہے۔"

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "مسلسل چالوں کی تعداد حد سے زیادہ خراب ہے۔"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "استعفیٰ دینے سے پہلے"

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "استعفیٰ پیش کرنے سے پہلے کھیل میں کھیلی جانے والی چالوں کی تعداد۔"

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "استعفیٰ سے پہلے انکار کے بعد تحریکوں کی تعداد دوبارہ پیش کی جا سکتی ہے۔"

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "جب زبردستی چیک میٹ ہو تو استعفیٰ پیش کرنے کے لیے چیک کریں۔"

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "شوٹ آؤٹ موڈ میں مستعفی ہونے کے لیے انجن چیک کریں، اگر جائز ہے۔"

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "جب انجن استعفی دینے کی پیشکش کرتا ہے تو صارف کو رضامندی کے لیے فوری طور پر چیک کریں۔"

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "انجن آٹو استعفیٰ کمزور یا مکمل طور پر کھوئے ہوئے انجنوں کی اجازت دیتا ہے۔"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "آپ کو وقت اور محنت خرچ کرنے پر مجبور کرنے کے بجائے معیاری استعفیٰ پیش کرنا"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "حتمی اقدام تک مکمل طور پر کھوئی ہوئی پوزیشن کو کھیلنا۔"

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "اختیارات کی ترتیب کی تفصیل -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "انجن خودکار استعفیٰ کو فعال کریں - شطرنج کے انجن کو مستعفی ہونے کی پیشکش کرنے کے لیے فعال کرنے کے لیے چیک کریں۔"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "استعفیٰ کی حد - پیادوں میں عددی تشخیص کی حد مقرر کریں۔"

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "کہ انجن کو استعفیٰ دینے کے لیے پوزیشن اس سے بھی بدتر ہونی چاہیے۔"

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "پہلے سے طے شدہ ہے -15.0 پیادے۔  اسے صرف انجن گیمز کے لیے -3.0 تک کم کیا جا سکتا ہے۔"

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "تلاش کی کم از کم گہرائی - وہ گہرائی درج کریں جس تک انجن کو پہلے پہنچنا چاہیے۔"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "انجن استعفی دینے کی پیشکش کرتا ہے.  یہ ابتدائی حساب کے اسپائکس یا اتار چڑھاؤ کو روکتا ہے۔"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "گھبراہٹ کے استعفوں کا سبب بننے سے حکمت عملی کی قربانیاں۔"

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "حد سے نیچے لگاتار موڑ - اس سے بدتر چالوں کی تعداد درج کریں۔"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "وہ حد جسے انجن کے استعفیٰ دینے کی پیشکش کرنے سے پہلے گزرنا پڑتا ہے۔"

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "یہ ایک اضافی چیک ہے، جو بہت زیادہ تھروٹل انجنوں کے لیے ضروری ہے۔"

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "جو کبھی بھی تلاش کی گہرائیوں تک نہیں پہنچ پاتے۔"

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "کم از کم گیم موو کی حد - ان چالوں کی تعداد درج کریں جو کھیلی جانی ہیں۔"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "استعفی کی پیشکش سے پہلے کھیل میں."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "اگر انکار کا سامنا کرنا پڑا تو انتظار کرنے کے لئے منتقل - انجن کی مکمل چالوں کی تعداد درج کریں۔"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "انجن سے پہلے صارف کے استعفیٰ کی پیشکش کو قبول کرنے سے انکار کرنے کے بعد انتظار کرنا پڑتا ہے۔"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "دوبارہ مستعفی ہونے کی پیشکش"

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "جبری چیک میٹ شامل کریں - جبری ساتھیوں کو شامل کرنے کے لیے چیک کریں، انجن کی طرف سے پیش گوئی،"

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "استعفی کی پیشکش کے معیار میں."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "اگر آپ اپنے لیے چیک میٹ بنانا چاہتے ہیں تو آپ اسے چھوڑنا چاہتے ہیں۔"

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "انجن شوٹ آؤٹ میں استعفیٰ دیں - شوٹ آؤٹ موڈ میں مستعفی ہونے کے لیے انجن کو چیک کریں،"

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "اگر استعفیٰ کے دیگر معیارات پورے ہو گئے ہیں۔"

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "استعفیٰ دینے سے پہلے پوچھیں - چیک کریں کہ آیا آپ انجن کو صارف سے رضامندی حاصل کرنا چاہتے ہیں۔"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "اس سے پہلے کہ یہ انسان بمقابلہ انجن گیم میں مستعفی ہو جائے۔"

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "انجن بمقابلہ انجن گیمز میں، انجن خاموشی سے مستعفی ہو جائے گا،"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "اجازت طلب کیے بغیر۔"

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "انجن استعفیٰ کی دستاویزات"

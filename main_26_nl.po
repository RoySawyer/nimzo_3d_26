#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Opties voor het opnieuw starten van de motor"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Toon het dialoogvenster met de opties voor het opnieuw starten van de engine."

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Er mogen niet meer dan 100 motoren deelnemen aan een motorentoernooi."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Opties voor het afmelden van de engine"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Een optie om het Free Internet Chess Server (FICS)-venster vast te zetten (versie 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automatische motoruitschakeling bij verlies van positie (versie 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (versie 4.41) meertalig,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Functies toegevoegd aan Nimzo_3d - versie 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "De motor schat zijn positie in als verloren."

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "en biedt aan ontslag te nemen."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Accepteert u het ontslag?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Bericht over het afhaken van de motor"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Bied in dit spel niet opnieuw aan om ontslag te nemen."

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Schakel automatisch opnieuw ondertekenen van de engine in."

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Drempelwaarde voor opgave (Pionnen: -1,0 tot -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimale zoekdiepte (lagen: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Opeenvolgende beurten onder de drempelwaarde (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Spelzetten gespeeld vóór de eerste schaak (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Moties om te wachten indien ontslag wordt afgewezen (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Inclusief geforceerde schaakmatten"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Schakel de regels voor het opgeven van een shootout in."

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Speler tegen engine-spellen"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Vraag het eerst voordat je ontslag neemt."

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Maakt automatische beëindiging van de engine mogelijk."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Definieert het numerieke pionnentekort dat nodig is om opgave aan te bieden."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Minimale zoekdiepte die de zoekmachine moet bereiken voordat ontslag wordt aangeboden."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Aantal opeenvolgende zetten slechter dan de drempelwaarde"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "voordat het ontslag wordt aangeboden."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Het aantal zetten dat in een partij wordt gespeeld voordat er opgave wordt aangeboden."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Aantal stappen na een afwijzing voordat ontslag opnieuw kan worden aangeboden."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Schaak om opgave aan te bieden wanneer er sprake is van een gedwongen schaakmat."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Controleer of de motor in de shootout-modus moet worden uitgeschakeld, indien gerechtvaardigd."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Schakel deze optie in om de gebruiker om toestemming te vragen wanneer de engine aanbiedt om af te haken."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "De automatische motoruitvalfunctie maakt het mogelijk om verzwakte of volledig uitvallende motoren te beveiligen."

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "een standaard ontslagregeling aanbieden, in plaats van je te dwingen tijd en moeite te investeren."

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "Een volledig verloren positie tot de allerlaatste zet uitspelen."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Configuratiebeschrijving van de opties -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Automatisch opgeven van de engine inschakelen - Vink dit aan om de schaakengine de mogelijkheid te geven om op te geven."

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Opgavedrempel - Stel de numerieke evaluatiedrempel in voor pionnen."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "De situatie moet wel slechter zijn, wil de motorfabrikant ontslag nemen."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "De standaardwaarde is -15,0 pionnen. Dit kan worden verlaagd tot -3,0 voor spellen die alleen door de engine worden gespeeld."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimale zoekdiepte - Voer de diepte in die de zoekmachine moet bereiken voordat"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "De engine biedt aan om zich terug te trekken. Dit voorkomt vroege rekenpieken of volatiele gegevens."

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "tactische offers om paniekontslagen te voorkomen."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Opeenvolgende zetten onder de drempelwaarde - Voer het aantal zetten in dat slechter is dan"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "De drempel die overschreden moet worden voordat de engine aanbiedt om ermee te stoppen."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Dit is een extra controle, essentieel voor motoren met een hoge gasklepstand."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "die nooit diepere zoekdiepten bereiken."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimum aantal zetten - Voer het aantal zetten in dat gespeeld moet worden"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "in een spel voordat ontslag wordt aangeboden."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Aantal zetten om te wachten bij weigering - Voer het aantal volledige zetten in dat de engine moet wachten."

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "moet wachten nadat de gebruiker een ontslagvoorstel heeft geweigerd, voordat de engine"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "biedt opnieuw aan om ontslag te nemen."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Inclusief geforceerde matten - Vink aan om geforceerde matten, zoals voorzien door de engine, op te nemen."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "in de criteria voor het ontslagaanbod."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Je kunt dit weglaten als je zelf een schaakmat wilt uitwerken."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Opgeven tijdens motorgevecht - Controleer of de motor zich terugtrekt in de gevechtsmodus."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "als aan de overige ontslagcriteria is voldaan."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Vraag toestemming voordat je ontslag neemt - Controleer of je wilt dat de engine toestemming van de gebruiker verkrijgt."

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "voordat het zich overgeeft in een spel tussen mens en computer."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "In spellen tussen twee verschillende computersystemen zal de computer zich stilzwijgend gewonnen geven."

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "zonder toestemming te vragen."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Documentatie voor het buiten bedrijf stellen van een motor"

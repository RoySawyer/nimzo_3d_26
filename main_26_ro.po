#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Opțiuni de renunțare la motor"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Afișează caseta de dialog a opțiunilor de renunțare la motor"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Nu pot fi mai mult de 100 de motoare într-un turneu de motoare."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Opțiuni de renunțare la motor"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "O opțiune pentru a andoca fereastra Free Internet Chess Server (FICS) (versiunea 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Renunțarea automată a motorului într-o poziție pierdută (versiunea 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (versiunea 4.41) multilingv,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Funcții adăugate la Nimzo_3d - versiunea 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Motorul își evaluează poziția ca fiind pierdută"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "și se oferă să demisioneze."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Acceptați demisia?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Mesaj de demisie a motorului"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Nu te mai oferi să demisionezi în acest joc."

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Activează oprirea automată a motorului"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Pragul de abandon (Pioni: -1.0 până la -50.0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Adâncime minimă de căutare (Straturi: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Viraj consecutiv sub prag (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Mutări de joc efectuate înainte de prima verificare (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Se așteaptă dacă demisia este respinsă (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Include șah-mat forțat"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Activează regulile de demisie din timpul unei împușcături"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Jocuri jucător versus motor"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Întreabă înainte de a demisiona"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Activează oprirea automată a motorului."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Definește deficitul numeric de pioni necesar pentru a oferi renunțarea."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Adâncimea minimă de căutare pe care motorul trebuie să o atingă înainte de a oferi o abandon."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Numărul de mișcări consecutive mai slabe decât pragul"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "înainte de a fi oferită demisia."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Numărul de mutări jucate într-un joc înainte de a se oferi demisia."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Numărul de mutări după un refuz înainte ca demisia să poată fi oferită din nou."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Verificare pentru a oferi demisia atunci când există un șah-mat forțat."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Verificați dacă motorul se oprește în modul de declanșare a împușcăturilor, dacă este justificat."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Bifați pentru a solicita consimțământul utilizatorului atunci când motorul oferă să se retragă."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Auto-abandonarea motorului permite motoarelor slăbite sau complet defectate"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "să oferi o demisie standard, în loc să te oblige să dedici timp și efort"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "jucând o poziție complet pierdută până la mutarea finală."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Descrierea configurării opțiunilor -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Activează auto-renunțarea motorului - Bifează pentru a permite motorului de șah să ofere renunțarea"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Prag de demisie - Setați pragul numeric de evaluare în pioni."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "că poziția trebuie să fie mai rea decât asta, pentru ca motorul să-și ofere demisia."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Implicit este -15.0 pioni. Aceasta valoare poate fi setată până la -3.0 pentru jocurile exclusiv cu motor."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Adâncimea minimă de căutare - Introduceți adâncimea pe care motorul trebuie să o atingă înainte"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "motorul oferă să se retragă. Acest lucru previne vârfurile de calcul timpurii sau volatilitatea"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "sacrificii tactice de la provocarea demisiilor panicate."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Rundaje consecutive sub prag - Introduceți numărul de mutări mai slabe decât"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "pragul care trebuie depășit înainte ca motorul să ofere să demisioneze."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Aceasta este o verificare suplimentară, esențială pentru motoarele cu accelerație puternică"

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "care nu ating niciodată adâncimi de căutare mai mari."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Limită minimă de mutări în joc - Introduceți numărul de mutări care trebuie jucate"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "într-un joc înainte de a fi oferită demisia."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Mutări de așteptat în cazul unui refuz - Introduceți numărul de mutări complete pe care motorul le-a efectuat"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "trebuie să aștepte după ce utilizatorul refuză să accepte o ofertă de demisie, înainte ca motorul"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "oferă din nou să demisioneze."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Include șah-mat forțat - Bifează pentru a include mat-urile forțate, prevăzute de motor,"

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "în criteriile ofertei de demisie."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Poate vrei să omiți asta, dacă vrei să-ți faci șah-mat."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Renunțați în modul de împușcare a motorului - Verificați dacă motorul renunță în modul de împușcare,"

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "dacă au fost îndeplinite celelalte criterii de demisie."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Întreabă înainte de a demisiona - Bifează dacă dorești ca motorul să obțină consimțământul utilizatorului"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "înainte de a demisiona într-un joc om versus motor."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "În jocurile motor versus motor, motorul va ceda în tăcere,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "fără să ceri permisiunea."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Documentație de renunțare la motor"

#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Alternativer for å avslutte motoren"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Vis dialogboksen for avslutningsalternativer for motoren"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Det kan ikke være mer enn 100 motorer i en motorturnering."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Alternativer for oppsigelse av motor"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Et alternativ for å forankre FICS-vinduet (versjon 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automatisk motoravgang i en tapt posisjon (versjon 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (versjon 4.41) flerspråklig,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Funksjoner lagt til Nimzo_3d - versjon 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Motoren vurderer posisjonen sin som tapt"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "og tilbyr seg å si opp."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Godtar du oppsigelsen?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Melding om motoravgang"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Ikke tilby å trekke seg igjen i dette spillet"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Aktiver automatisk avgang av motoren"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Oppsigelsesterskel (Bønder: -1,0 til -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimum søkedybde (lag: 1–30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Påfølgende svinger under terskelen (1–10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Spilltrekk spilt før første kontroll (1–50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Forespørsler om å vente hvis oppsigelsen avvises (1–50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Inkluder tvungne sjakkmatter"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Aktiver regler for oppsigelse i straffeutmåling"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Spiller mot motor-spill"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Spør før du sier opp"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Aktiverer automatisk motoravslutning."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Definerer det numeriske bondeunderskuddet som kreves for å tilby resignasjon."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Minimum søkedybde søkemotoren må oppnå før oppsigelse tilbys."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Antall påfølgende trekk dårligere enn terskelen"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "før oppsigelse tilbys."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Antall trekk spilt i et parti før oppsigelse tilbys."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Antall trekk etter en avslag før oppsigelse kan tilbys på nytt."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Kryss av for å tilby avskjed når det er tvungen sjakkmatt."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Sjekk om motoren skal avbryte skuddmodus, hvis det er berettiget."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Kryss av for å be brukeren om samtykke når motoren tilbyr å avslutte."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Automatisk motoravgang tillater svekkede eller fullstendig tapende motorer"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "å tilby standard oppsigelse, i stedet for å tvinge deg til å bruke tid og krefter"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "spiller ut en fullstendig tapt posisjon til det siste trekket."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Beskrivelse av alternativkonfigurasjon -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Aktiver automatisk oppsigelse av motor – Kryss av for å aktivere at sjakkmotoren skal tilby å trekke seg"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Oppsigelsesterskel – Angi den numeriske evalueringsterskelen i bønder."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "at stillingen må være verre enn, for at motoren skal tilby resignasjon."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Standardinnstillingen er -15,0 bønder. Dette kan settes så lavt som -3,0 for spill med kun motor."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimum søkedybde – Skriv inn dybden motoren må nå før"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "motoren tilbyr å avslutte. Dette forhindrer tidlige beregningstopper eller volatile variasjoner"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktiske ofre fra å forårsake panikkoppsigelser."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Påfølgende runder under terskelen – Skriv inn antall trekk som er dårligere enn"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "terskelen som må passeres før motoren tilbyr å trekke seg."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Dette er en ekstra sjekk, viktig for motorer med høy gasspådrag"

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "som aldri når dypere søkedybder."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimumsgrense for antall trekk i spillet – Skriv inn antall trekk som må spilles"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "i et spill før oppsigelse tilbys."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Ventetrekk hvis avslag oppstår – Skriv inn antall fulle trekk som motoren"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "må vente etter at brukeren nekter å godta et oppsigelsestilbud, før motoren"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "tilbyr seg å trekke seg igjen."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Inkluder tvungne sjakkmatter - Kryss av for å inkludere tvungne matter, forutsett av motoren,"

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "i kriteriene for oppsigelsestilbudet."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Du kan gjerne droppe dette hvis du vil finne ut en sjakkmatt for deg selv."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Avbryt i motorskuddveksling - Sjekk om motoren skal avbryte i skuddvekslingsmodus,"

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "dersom de andre oppsigelseskriteriene er oppfylt."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Spør før du avslutter – Kryss av om du vil at søkemotoren skal innhente samtykke fra brukeren."

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "før den gir opp i et menneske mot motor-spill."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "I spill med motor mot motor vil motoren stille gi seg,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "uten å spørre om tillatelse."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Dokumentasjon for oppsigelse av motor"

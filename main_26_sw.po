#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Chaguzi za kujiuzulu kwa injini"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Onyesha kisanduku cha mazungumzo cha chaguo za kujiuzulu kwa injini"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Hakuwezi kuwa na injini zaidi ya 100 katika mashindano ya injini."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Chaguzi za Kujiuzulu kwa Injini"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Chaguo la kuweka dirisha la Seva ya Chesi ya Mtandaoni Huria (FICS) (toleo la 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Kuacha injini kiotomatiki katika nafasi iliyopotea (toleo la 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (toleo la 4.41) lugha nyingi,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Vipengele vimeongezwa kwenye Nimzo_3d - toleo la 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Injini inatathmini nafasi yake kama iliyopotea"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "na anajitolea kujiuzulu."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Je, unakubali kujiuzulu?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Ujumbe wa Kujiuzulu kwa Injini"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Usijiuzulu tena mchezo huu"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Washa kujiondoa kiotomatiki kwa injini"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Kizingiti cha kujiuzulu (Vituo vya kulipwa: -1.0 hadi -50.0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Kina cha chini kabisa cha utafutaji (Vipande: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Mzunguko mfululizo chini ya kizingiti (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Hatua za mchezo zilizochezwa kabla ya ukaguzi wa kwanza (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Hatua za kusubiri ikiwa kujiuzulu kukataliwa (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Jumuisha wachuuzi wa kulazimishwa"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Washa sheria za kujiuzulu kwa mikwaju ya risasi"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Michezo ya mchezaji dhidi ya injini"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Uliza kabla ya kujiuzulu"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Huwezesha kuzima injini kiotomatiki."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Hufafanua upungufu wa nambari ya kibaraka unaohitajika ili kutoa kujiuzulu."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Kina cha chini cha utafutaji ambacho injini lazima ifikie kabla ya kujiondoa kutolewa."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Idadi ya hatua mfululizo ni mbaya zaidi kuliko kizingiti"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "kabla ya kujiuzulu kutolewa."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Idadi ya hatua zilizochezwa katika mchezo kabla ya kujiuzulu hutolewa."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Idadi ya hoja baada ya kukataa kabla ya kujiuzulu inaweza kutolewa tena."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Hundi ya kutoa kujiuzulu wakati kuna mhusika aliyelazimishwa kuajiriwa."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Angalia kama injini imeacha kupiga risasi katika hali ya mikwaju ya risasi, ikiwa inafaa."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Angalia ili kumwomba mtumiaji idhini wakati injini inapojitolea kujiuzulu."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Kujiuzulu Kiotomatiki kwa Injini huruhusu injini dhaifu au zinazopotea kabisa"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "kutoa kujiuzulu kwa kawaida, badala ya kukulazimisha kutumia muda na juhudi"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "kucheza nafasi iliyopotea kabisa hadi hatua ya mwisho."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Maelezo ya usanidi wa chaguo -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Washa kujiuzulu kiotomatiki kwa injini - Angalia ili kuwezesha injini ya chess kujiuzulu"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Kizingiti cha kujiuzulu - Weka kizingiti cha tathmini ya nambari katika vibao."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "kwamba nafasi hiyo lazima iwe mbaya zaidi kuliko, ili injini itoe kujiuzulu."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Chaguo-msingi ni pawns -15.0. Hii inaweza kuwekwa chini kama -3.0 kwa michezo ya injini pekee."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Kina cha chini cha utafutaji - Ingiza kina ambacho injini lazima ifikie kabla"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "injini inatoa nafasi ya kuzima. Hii inazuia miisho ya hesabu mapema au tete"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "kujitolea kimkakati kutokana na kusababisha kujiuzulu kwa hofu."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Zamu mfululizo chini ya kizingiti - Ingiza idadi ya hatua mbaya zaidi kuliko"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "kizingiti kinachopaswa kupita kabla injini haijatoa ombi la kuacha kazi."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Huu ni ukaguzi wa ziada, muhimu kwa injini zenye kaba nyingi"

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "ambazo hazifikii kina cha utafutaji cha ndani zaidi."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Kikomo cha chini cha mchezo wa kuhama - Ingiza idadi ya hatua zinazopaswa kuchezwa"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "katika mchezo kabla ya kutolewa kwa kujiuzulu."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Hatua za kusubiri ikiwa kukataliwa kutatokea - Ingiza idadi ya hatua kamili ambazo injini imechukua"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "inabidi kusubiri baada ya mtumiaji kukataa kukubali ofa ya kujiuzulu, kabla ya injini"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "anatoa kujiuzulu tena."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Jumuisha wachunguzi wa kulazimishwa - Hakikisha unajumuisha wachunguzi wa kulazimishwa, waliotabiriwa na injini,"

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "katika vigezo vya ofa ya kujiuzulu."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Unaweza kutaka kuacha hili, ikiwa unataka kujifanyia kazi mtu wa kuangalia."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Kujiuzulu katika mikwaju ya injini - Angalia kama injini imejiuzulu katika hali ya mikwaju ya risasi,"

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "ikiwa vigezo vingine vya kujiuzulu vimetimizwa."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Uliza kabla ya kujiuzulu - Angalia kama unataka injini ipate idhini kutoka kwa mtumiaji"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "kabla haijajiuzulu katika mchezo wa binadamu dhidi ya injini."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "Katika michezo ya injini dhidi ya injini, injini itaacha kufanya kazi kimya kimya,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "bila kuomba ruhusa."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Nyaraka za Kujiuzulu kwa Injini"

#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Variklio išmontavimo parinktys"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Rodyti variklio išstojimo parinkčių dialogo langą"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Variklių turnyre negali būti daugiau nei 100 variklių."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Variklio atsistatydinimo parinktys"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Galimybė prijungti „Free Internet Chess Server“ (FICS) langą (4.4 versija)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automatinis variklio išsijungimas prarastoje padėtyje (4.41 versija)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "„Nimzo_3d_ml“ (4.41 versija) – daugiakalbis,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Į „Nimzo_3d“ – 4.41 versija – pridėtos funkcijos"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Variklis įvertina savo padėtį kaip prarastą"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "ir siūlo atsistatydinti."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Ar priimate atsistatydinimą?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Variklio atsisakymo pranešimas"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Daugiau nesiūlykite pasitraukti šiame žaidime"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Įgalinti variklio automatinį pasitraukimą"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Pasitraukimo slenkstis (pėstininkai: nuo -1,0 iki -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimalus paieškos gylis (sluoksniai: 1–30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Iš eilės einantys posūkiai žemiau ribos (1–10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Žaidimo ėjimai, atlikti prieš pirmąjį patikrinimą (1–50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Ar verta laukti, jei atsistatydinimas atmetamas (1–50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Įtraukti priverstinius šachmatininkus"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Įjungti šaudymo atsistatydinimo taisykles"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Žaidėjų ir variklių žaidimai"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Prieš atsistatydindami paklauskite"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Įgalina automatinį variklio išsijungimą."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Apibrėžia skaitmeninį pėstininko deficitą, reikalingą atsistatydinti."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Minimalus paieškos gylis, kurį turi pasiekti paieškos sistema, kad būtų pasiūlytas atsistatydinimas."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Iš eilės einančių ėjimų, blogesnių už ribą, skaičius"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "prieš pateikdamas atsistatydinimo pasiūlymą."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Žaidime atliktų ėjimų skaičius prieš pasitraukimo pasiūlymą."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Žingsnių skaičius po atsisakymo, prieš vėl siūlant atsistatydinti."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Čekis, kad pasiūlytumėte atsistatydinimą, kai yra priverstinis matas."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Jei pagrįsta, patikrinkite, ar variklis atsistato šaudymo režimu."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Pažymėkite, kad būtų prašoma vartotojo sutikimo, kai variklis siūlo išeiti."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Variklio automatinis atsistatydinimas leidžia susilpnėjusiems arba visiškai išsijungusiems varikliams"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "pasiūlyti standartinį atsistatydinimą, o ne versti jus gaišti laiką ir pastangas"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "žaidžiant visiškai prarastą poziciją iki paskutinio ėjimo."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Parinkčių konfigūracijos aprašymas -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Įjungti automatinį šachmatų variklio pasitraukimą – pažymėkite, jei norite, kad šachmatų variklis pasiūlytų pasitraukti."

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Pasitraukimo slenkstis – nustatykite skaitmeninį pėstininkų įvertinimo slenkstį."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "kad variklis atsistatydintų, padėtis turi būti blogesnė."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Numatytoji reikšmė yra -15,0 pėstininkų. Žaidimuose, kuriuose naudojamas tik variklis, šią reikšmę galima nustatyti net iki -3,0."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimalus paieškos gylis – įveskite gylį, kurį variklis turi pasiekti prieš"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "variklis siūlo pasitraukti. Tai apsaugo nuo ankstyvų skaičiavimo šuolių ar nepastovių"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktinės aukos nuo panikos sukelto atsistatydinimo."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Iš eilės einantys posūkiai žemiau ribos – įveskite ėjimų, kurie yra blogesni nei"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "riba, kurią reikia peržengti, kad variklis pasiūlytų pasitraukti."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Tai papildomas patikrinimas, būtinas varikliams, kurių droselis stipriai apkrautas."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "kurie niekada nepasiekia gilesnių paieškos gelmių."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimalus žaidimo ėjimų skaičius – įveskite ėjimų, kuriuos reikia atlikti, skaičių."

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "rungtynėse prieš pasitraukimo pasiūlymą."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Laukiami judesiai, jei atsisakoma – įveskite pilnų judesių, kuriuos variklis atliko, skaičių."

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "turi palaukti, kai vartotojas atsisako priimti atsistatydinimo pasiūlymą, prieš tai, kai variklis"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "vėl siūlo atsistatydinti."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Įtraukti priverstinius matininkus – pažymėkite, kad įtrauktumėte priverstinius matininkus, numatytus variklio."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "atsistatydinimo pasiūlymo kriterijuose."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Galite to nedaryti, jei norite susirasti sau šachmatą."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Atsistatydinimas variklio bandymų metu – patikrinkite, ar variklis atsistatydina bandymų režimu."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "jei buvo įvykdyti kiti atsistatydinimo kriterijai."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Paklausti prieš atsistatydinant – Pažymėkite, jei norite, kad paieškos sistema gautų vartotojo sutikimą"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "prieš jam pasiduodant žmogaus ir variklio žaidime."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "Variklis prieš variklį žaidimuose variklis tyliai pasiduoda,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "neprašant leidimo."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Variklio atsistatydinimo dokumentai"

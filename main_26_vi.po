#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Tùy chọn ký lại động cơ"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Hiển thị hộp thoại tùy chọn từ bỏ công cụ"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Trong một giải đấu động cơ, không được phép có quá 100 động cơ tham gia."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Các tùy chọn từ bỏ động cơ"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Tùy chọn ghim cửa sổ Máy chủ Cờ vua Internet miễn phí (FICS) (phiên bản 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Tự động tắt máy khi mất vị trí (phiên bản 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (phiên bản 4.41) đa ngôn ngữ,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Các tính năng được thêm vào Nimzo_3d - phiên bản 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Động cơ đánh giá vị trí của nó là bị mất."

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "và đề nghị từ chức."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Ông/Bà có chấp nhận đơn từ chức không?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Thông báo ngừng hoạt động của động cơ"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Đừng đề nghị từ chức lần nữa trong trò chơi này."

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Bật tính năng tự động ký lại công cụ."

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Ngưỡng từ chức (Quân tốt: -1,0 đến -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Độ sâu tìm kiếm tối thiểu (Lớp: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Số lượt chơi liên tiếp dưới ngưỡng (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Các nước đi được thực hiện trước khi chiếu lần đầu (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Các bước chờ đợi nếu đơn từ chức bị từ chối (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Bao gồm cả chiếu hết bắt buộc"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Kích hoạt quy tắc từ chức trong cuộc đấu súng."

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Trò chơi người chơi đấu với máy tính"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Hãy hỏi trước khi từ chức."

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Cho phép tự động tắt động cơ."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Xác định mức thiếu hụt quân cờ cần thiết để chấp nhận đầu hàng."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Độ sâu tìm kiếm tối thiểu mà công cụ tìm kiếm phải đạt được trước khi đưa ra đề nghị từ bỏ."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Số lần di chuyển liên tiếp tệ hơn ngưỡng quy định"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "trước khi nộp đơn từ chức."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Số nước đi được thực hiện trong một ván cờ trước khi người chơi tuyên bố đầu hàng."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Số lần chuyển nhượng sau khi từ chối trước khi có thể nộp đơn từ chức lại."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Kiểm tra xem có nên đề nghị đầu hàng khi bị chiếu hết không thể tránh khỏi hay không."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Kiểm tra xem động cơ có sẵn sàng ngừng hoạt động trong chế độ đấu súng hay không, nếu cần thiết."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Kiểm tra xem có cần yêu cầu người dùng đồng ý khi công cụ đề nghị từ bỏ quyền truy cập hay không."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Chức năng Tự động ngừng hoạt động của động cơ cho phép các động cơ yếu hoặc bị hỏng hoàn toàn hoạt động."

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "Đưa ra mẫu đơn xin nghỉ việc tiêu chuẩn, thay vì bắt bạn phải tốn thời gian và công sức."

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "Chơi một thế trận hoàn toàn bất lực cho đến nước đi cuối cùng."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Mô tả cấu hình tùy chọn -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Bật chế độ tự động bỏ cuộc của công cụ cờ vua - Chọn tùy chọn này để cho phép công cụ cờ vua đề nghị bỏ cuộc."

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Ngưỡng từ chức - Đặt ngưỡng đánh giá số học theo đơn vị quân cờ."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "Tình hình phải tồi tệ hơn thế thì động cơ mới chịu từ chức."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Mặc định là -15,0 quân cờ. Có thể đặt giá trị này thấp hơn, chẳng hạn như -3,0, đối với các trò chơi chỉ sử dụng chương trình máy tính."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Độ sâu tìm kiếm tối thiểu - Nhập độ sâu mà công cụ tìm kiếm phải đạt được trước khi"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "Công cụ này đề nghị từ bỏ. Điều này ngăn ngừa các đột biến tính toán sớm hoặc sự biến động."

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "Những hy sinh mang tính chiến thuật nhằm tránh gây ra sự hoảng loạn và dẫn đến việc từ chức."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Số lượt chơi liên tiếp dưới ngưỡng - Nhập số lượt chơi tệ hơn"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "Ngưỡng giới hạn mà động cơ phải vượt qua trước khi tự nguyện ngừng hoạt động."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Đây là một bước kiểm tra bổ sung, rất cần thiết đối với các động cơ bị giảm công suất mạnh."

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "những thứ không bao giờ đạt đến độ sâu tìm kiếm lớn hơn."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Giới hạn số nước đi tối thiểu trong trò chơi - Nhập số nước đi cần thực hiện."

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "trong một ván bài trước khi người chơi đưa ra lời đầu hàng."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Các nước đi cần chờ nếu gặp phải sự từ chối - Nhập số nước đi đầy đủ mà công cụ có thể thực hiện."

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "Phải đợi sau khi người dùng từ chối chấp nhận đề nghị thôi việc, trước khi hệ thống xử lý."

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "Đề nghị từ chức lần nữa."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Bao gồm chiếu hết bắt buộc - Kiểm tra để bao gồm các nước chiếu hết bắt buộc, được phần mềm dự đoán trước."

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "trong các tiêu chí đề nghị từ chức."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Bạn có thể bỏ qua phần này nếu muốn tự mình tìm ra nước chiếu hết."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Kiểm tra xem động cơ có bỏ cuộc trong chế độ đấu súng hay không."

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "nếu các tiêu chí từ chức khác đã được đáp ứng."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Hãy hỏi trước khi từ chức - Kiểm tra xem bạn có muốn hệ thống lấy sự đồng ý từ người dùng hay không."

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "trước khi nó bỏ cuộc trong một trận đấu giữa người chơi và máy tính."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "Trong các trận đấu giữa các engine với nhau, engine sẽ âm thầm bỏ cuộc."

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "mà không cần xin phép."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Tài liệu từ chức động cơ"

#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Muligheder for at opsige motoren"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Vis dialogboksen for afslutningsmuligheder for motoren"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "Der kan ikke være mere end 100 motorer i en motorturnering."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Muligheder for motoropsigelse"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "En mulighed for at docke Free Internet Chess Server (FICS)-vinduet (version 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automatisk motorafbrydelse i en mistet position (version 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (version 4.41) flersproget,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Funktioner tilføjet til Nimzo_3d - version 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Motoren vurderer sin position som tabt"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "og tilbyder at træde tilbage."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Accepterer du opsigelsen?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Meddelelse om motoropsigelse"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Tilbyd ikke at opsige igen i dette spil"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Aktivér automatisk motorafgang"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Opsigelsesgrænse (bønder: -1,0 til -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimum søgedybde (lag: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Fortløbende sving under tærsklen (1-10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Spiltræk spillet før første kontrol (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Foretager at vente, hvis opsigelsen afvises (1-50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Inkluder tvungne skakmatter"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Aktivér regler for opsigelse i straffeslag"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Spiller mod motor spil"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Spørg før du siger op"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Aktiverer automatisk motorafbrydelse."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Definerer det numeriske bondeunderskud, der kræves for at tilbyde opsigelse."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Minimum søgedybde, som søgemaskinen skal opnå, før der tilbydes opsigelse."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Antal på hinanden følgende træk værre end tærsklen"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "før opsigelse tilbydes."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Antal træk spillet i et parti før der tilbydes opgivelse."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Antal træk efter en afvisning før opsigelse kan tilbydes igen."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Sæt kryds for at tilbyde opsigelse, når der er tvungen skakmat."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Kontroller, om motoren skal afbrydes i skudtilstand, hvis det er berettiget."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Markér for at bede brugeren om samtykke, når motoren tilbyder at opsige."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Motorens automatiske opsigelse muliggør svækkede eller fuldstændigt mistede motorer"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "at tilbyde standard opsigelse, i stedet for at tvinge dig til at bruge tid og kræfter"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "spiller en fuldstændig tabt stilling ud til det sidste træk."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Beskrivelse af konfiguration af indstillinger -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Aktivér automatisk opsigelse af skakmotor - Markér for at aktivere skakmotoren til at tilbyde at opsige"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Opsigelsestærskel - Indstil den numeriske evalueringstærskel i brikker."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "at positionen skal være værre end, for at motoren kan tilbyde resignation."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Standardindstillingen er -15,0 bønder. Dette kan sættes så lavt som -3,0 for spil kun med en motor."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimum søgedybde - Indtast den dybde, som motoren skal nå, før"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "motoren tilbyder at afslutte. Dette forhindrer tidlige beregningsstigninger eller ustabile"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktiske ofre for at undgå at forårsage paniske opsigelser."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "På hinanden følgende ture under tærsklen - Indtast antallet af ture, der er værre end"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "den tærskel, der skal passeres, før motoren tilbyder at give op."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Dette er en ekstra kontrol, som er afgørende for motorer med høj gas"

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "som aldrig når dybere søgedybder."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimumsgrænse for træk i spillet - Indtast antallet af træk, der skal spilles"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "i et spil, før der tilbydes opsigelse."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Ventetrin, hvis der opstår afvisning - Indtast antallet af fulde træk, som motoren"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "skal vente efter at brugeren nægter at acceptere et opsigelsestilbud, før motoren"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "tilbyder at træde tilbage igen."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Inkluder tvungne skakmatter - Marker for at inkludere tvungne matter, forudset af motoren,"

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "i kriterierne for opsigelsestilbuddet."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Du kan eventuelt udelade dette, hvis du vil finde en skakmat til dig selv."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Giv af i motorskudveksling - Kontroller, om motoren skal give afkald i skudvekslingstilstand,"

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "hvis de øvrige kriterier for opsigelse er opfyldt."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Spørg før opsigelse - Markér, om du ønsker, at søgemaskinen skal indhente samtykke fra brugeren."

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "før den giver op i et menneske mod motor-spil."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "I spil med motor mod motor vil motoren lydløst give op,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "uden at spørge om tilladelse."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Dokumentation for motoropsigelse"

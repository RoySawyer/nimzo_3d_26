#: main_26.cpp:35
msgid "Engine resign options"
msgstr "Opcje wymiany silnika"

#: main_26.cpp:37
msgid "Show the engine resign options dialog box"
msgstr "Pokaż okno dialogowe opcji ponownego uruchomienia silnika"

#: main_26.cpp:39
msgid "There cannot be more than 100 engines in an engine tournament."
msgstr "W turnieju silników nie może wziąć udziału więcej niż 100 silników."

#: main_26.cpp:41
msgid "Engine Resignation Options"
msgstr "Opcje rezygnacji z silnika"

#: main_26.cpp:43
msgid "An option to dock the Free Internet Chess Server (FICS) window (version 4.4)"
msgstr "Opcja dokowania okna Free Internet Chess Server (FICS) (wersja 4.4)"

#: main_26.cpp:45
msgid "Automatic engine resignation in a lost position (version 4.41)"
msgstr "Automatyczne wyłączenie silnika w przypadku utraty pozycji (wersja 4.41)"

#: main_26.cpp:47
msgid "Nimzo_3d_ml (version 4.41) multi-lingual,"
msgstr "Nimzo_3d_ml (wersja 4.41) wielojęzyczna,"

#: main_26.cpp:49
msgid "Features added to Nimzo_3d - version 4.41"
msgstr "Funkcje dodane do Nimzo_3d – wersja 4.41"

#: main_26.cpp:51
msgid "The engine evaluates its position as lost"
msgstr "Silnik ocenia swoją pozycję jako utraconą"

#: main_26.cpp:52
msgid "and offers to resign."
msgstr "i składa rezygnację."

#: main_26.cpp:53
msgid "Do you accept the resignation?"
msgstr "Czy przyjmujesz rezygnację?"

#: main_26.cpp:54
msgid "Engine Resignation message"
msgstr "Komunikat o rezygnacji z silnika"

#: main_26.cpp:55
msgid "Do not offer to resign again this game"
msgstr "Nie proponuj już więcej rezygnacji z tej gry"

#: main_26.cpp:147
msgid "Enable engine auto-resign"
msgstr "Włącz automatyczne ponowne uruchamianie silnika"

#: main_26.cpp:159
msgid "Resignation threshold (Pawns: -1.0 to -50.0)"
msgstr "Próg rezygnacji (pionki: -1,0 do -50,0)"

#: main_26.cpp:173
msgid "Minimum search depth (Plies: 1 - 30)"
msgstr "Minimalna głębokość przeszukiwania (warstwy: 1 - 30)"

#: main_26.cpp:187
msgid "Consecutive turns below threshold (1 - 10)"
msgstr "Kolejne obroty poniżej progu (1 - 10)"

#: main_26.cpp:201
msgid "Game moves played before first check (1 - 50)"
msgstr "Ruchy gry wykonane przed pierwszym sprawdzeniem (1 - 50)"

#: main_26.cpp:215
msgid "Moves to wait if resignation rejected (1 - 50)"
msgstr "Ruchy o oczekiwaniu na odrzucenie rezygnacji (1 - 50)"

#: main_26.cpp:229
msgid "Include forced checkmates"
msgstr "Uwzględnij wymuszone maty"

#: main_26.cpp:241
msgid "Enable shootout resignation rules"
msgstr "Włącz zasady rezygnacji po rzutach karnych"

#: main_26.cpp:253
msgid "Player versus engine games"
msgstr "Gry gracz kontra silnik"

#: main_26.cpp:262
msgid "Ask before resigning"
msgstr "Zapytaj przed rezygnacją"

#: main_26.cpp:363
msgid "Enables automatic engine resignation."
msgstr "Umożliwia automatyczną rezygnację silnika."

#: main_26.cpp:364
msgid "Defines the numeric pawn deficit required to offer resignation."
msgstr "Określa deficyt liczbowy pionków wymagany do złożenia rezygnacji."

#: main_26.cpp:365
msgid "Minimum search depth the engine must attain before resignation is offered."
msgstr "Minimalna głębokość wyszukiwania, jaką musi osiągnąć wyszukiwarka, aby zaproponować rezygnację."

#: main_26.cpp:366
msgid "Number of consecutive moves worse than threshold"
msgstr "Liczba kolejnych ruchów gorszych od progu"

#: main_26.cpp:366
msgid "before resignation is offered."
msgstr "przed złożeniem rezygnacji."

#: main_26.cpp:367
msgid "Number of moves played in a game before resignation is offered."
msgstr "Liczba ruchów wykonanych w grze przed złożeniem oferty rezygnacji."

#: main_26.cpp:368
msgid "Number of moves after a refusal before resignation can be offered again."
msgstr "Liczba ruchów po odmowie zanim rezygnacja może zostać ponownie zaproponowana."

#: main_26.cpp:369
msgid "Check to offer resignation when there is a forced checkmate."
msgstr "Szachuj, aby zaoferować rezygnację, gdy występuje wymuszony szach-mat."

#: main_26.cpp:370
msgid "Check for engine to resign in shootout mode, if justified."
msgstr "Sprawdź, czy silnik wyłączy się w trybie rzutów karnych, jeżeli jest to uzasadnione."

#: main_26.cpp:371
msgid "Check to prompt user for consent when the engine offers to resign."
msgstr "Zaznacz, aby wyświetlać monit o zgodę użytkownika, gdy wyszukiwarka zaproponuje rezygnację."

#: main_26.cpp:405
msgid "Engine Auto-Resignation allows weakened or completely losing engines"
msgstr "Automatyczne wyłączanie silnika umożliwia osłabienie lub całkowitą utratę mocy silnika"

#: main_26.cpp:407
msgid "to offer standard resignation, rather than forcing you to spend time and effort"
msgstr "zaoferować standardową rezygnację, zamiast zmuszać Cię do poświęcenia czasu i wysiłku"

#: main_26.cpp:409
msgid "playing out a completely lost position to the final move."
msgstr "rozgrywając całkowicie przegraną pozycję aż do ostatniego ruchu."

#: main_26.cpp:412
msgid "Options configuration description -"
msgstr "Opis konfiguracji opcji -"

#: main_26.cpp:414
msgid "Enable engine auto-resign  -  Check to enable the chess engine to offer to resign"
msgstr "Włącz automatyczne podpisywanie przez silnik szachowy – zaznacz, aby włączyć opcję oferowania podpisywania przez silnik szachowy"

#: main_26.cpp:419
msgid "Resignation threshold  -  Set the numeric evaluation threshold in pawns."
msgstr "Próg rezygnacji - Ustaw próg oceny numerycznej w pionkach."

#: main_26.cpp:421
msgid "that the position has to be worse than, for the engine to offer resignation."
msgstr "że sytuacja musi być gorsza, aby silnik zaoferował rezygnację."

#: main_26.cpp:423
msgid "Default is -15.0 pawns.  This could be set as low as -3.0 for engine only games."
msgstr "Domyślnie pionki mają wartość -15,0. W grach z samym silnikiem wartość ta może wynosić nawet -3,0."

#: main_26.cpp:426
msgid "Minimum search depth  -  Input the depth that the engine must reach before"
msgstr "Minimalna głębokość wyszukiwania – wprowadź głębokość, jaką musi osiągnąć wyszukiwarka, aby"

#: main_26.cpp:428
msgid "the engine offers to resign.  This prevents early calculation spikes or volatile"
msgstr "Silnik proponuje rezygnację. Zapobiega to wczesnym skokom w obliczeniach lub zmienności"

#: main_26.cpp:430
msgid "tactical sacrifices from causing panic resignations."
msgstr "taktycznych poświęceń, które mogłyby spowodować paniczne rezygnacje."

#: main_26.cpp:433
msgid "Consecutive turns below threshold  -  Input the number of moves worse than"
msgstr "Kolejne obroty poniżej progu - Wprowadź liczbę ruchów gorszych niż"

#: main_26.cpp:435
msgid "the threshold that have to pass before the engine offers to resign."
msgstr "próg, który musi zostać przekroczony, zanim silnik zaproponuje rezygnację."

#: main_26.cpp:437
msgid "This is an additional check, essential for heavily throttled engines"
msgstr "Jest to dodatkowa kontrola, niezbędna w przypadku silników z dużymi przepustnicami"

#: main_26.cpp:439
msgid "that never reach deeper search depths."
msgstr "które nigdy nie docierają do głębszych warstw poszukiwań."

#: main_26.cpp:442
msgid "Minimum game move limit  -  Input the number of moves that have to be played"
msgstr "Minimalny limit ruchów w grze – wprowadź liczbę ruchów, które należy wykonać"

#: main_26.cpp:444
msgid "in a game before resignation is offered."
msgstr "w grze przed złożeniem rezygnacji."

#: main_26.cpp:447
msgid "Moves to wait if refusal encountered  -  Input the number of full moves that the engine"
msgstr "Ruchy do oczekiwania w przypadku napotkania odmowy - Wprowadź liczbę pełnych ruchów, które silnik wykona"

#: main_26.cpp:449
msgid "has to wait after the user refuses to accept a resignation offer, before the engine"
msgstr "musi poczekać, aż użytkownik odmówi przyjęcia oferty rezygnacji, zanim silnik"

#: main_26.cpp:451
msgid "offers to resign again."
msgstr "ponownie składa rezygnację."

#: main_26.cpp:454
msgid "Include forced checkmates  -  Check to include forced mates, foreseen by the engine,"
msgstr "Uwzględnij wymuszone maty - Sprawdź, czy uwzględniono wymuszone maty przewidziane przez silnik,"

#: main_26.cpp:456
msgid "in the resignation offer criteria."
msgstr "w kryteriach składania ofert rezygnacji."

#: main_26.cpp:458
msgid "You may want to leave this off, if you want to work out a checkmate for yourself."
msgstr "Możesz pominąć tę opcję, jeśli chcesz samemu wypracować mata."

#: main_26.cpp:461
msgid "Resign in engine shootout  -  Check for the engine to resign in shootout mode,"
msgstr "Zrezygnuj w strzelaninie silników - Sprawdź, czy silnik zrezygnuje w trybie strzelaniny,"

#: main_26.cpp:463
msgid "if the other resignation criteria have been fulfilled."
msgstr "jeżeli pozostałe kryteria rezygnacji zostały spełnione."

#: main_26.cpp:464
msgid "Ask before resigning  -  Check if you want the engine to get consent from the user"
msgstr "Zapytaj przed rezygnacją – zaznacz, czy chcesz, aby wyszukiwarka uzyskała zgodę użytkownika"

#: main_26.cpp:466
msgid "before it resigns in a human versus engine game."
msgstr "zanim zrezygnuje w grze człowiek kontra silnik."

#: main_26.cpp:468
msgid "In engine versus engine games, the engine will silently resign,"
msgstr "W grach typu silnik kontra silnik silnik po cichu zrezygnuje,"

#: main_26.cpp:470
msgid "without asking for permission."
msgstr "bez pytania o pozwolenie."

#: main_26.cpp:473
msgid "Engine Resignation Documentation"
msgstr "Dokumentacja rezygnacji z silnika"
